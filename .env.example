# 服务监听
HOST=127.0.0.1
PORT=3000
# 允许的 Host（逗号分隔，不含端口）；HOST 为非回环地址时必填
ALLOWED_HOSTS=

# 数据库路径：相对路径以项目根目录解析；首次运行 npm run db:init 建库
DATABASE_PATH=data/team-plan.sqlite

# development / test / production
NODE_ENV=development

# 优先级和搜索筛选默认启用；关闭两项时保留旧 API，已有优先级不清除
ENABLE_PRIORITY=1
ENABLE_FILTERS=1
ENABLE_ORDERING=0
ENABLE_SHARING=0

# EDITOR_KEY 仅在 S5 选择 P2 分享功能后使用，当前后端不读取

# 演示数据库路径（仅 npm run db:demo / db:reset-demo 使用，与 DATABASE_PATH 相互独立）
DEMO_DATABASE_PATH=data/team-plan-demo.sqlite
