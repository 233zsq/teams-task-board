    "@vitejs/plugin-vue": "6.0.10", "@vue/test-utils": "2.5.1",
    "jsdom": "30.1.3", "typescript": "5.6.3", "vite": "8.3.5",
    "vitest": "5.0.5", "vue-tsc": "3.3.13"
  }
}
