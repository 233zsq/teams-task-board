{
  "name": "@team-plan/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "db:init": "tsx src/db/init.ts",
    "db:demo": "tsx src/db/demo-cli.ts",
    "db:reset-demo": "tsx src/db/reset-demo-cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@team-plan/shared": "0.1.0",
    "better-sqlite3": "11.10.0",
    "dotenv": "16.4.7",
    "express": "5.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.12",
    "@types/express": "5.0.0",
    "@types/node": "18.19.50",
    "@types/supertest": "6.0.2",
    "supertest": "7.0.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "2.1.9"
  }
}